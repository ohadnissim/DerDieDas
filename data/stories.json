   "pages": [
    {
     "img": "img/story4-1.webp",
     "audio": "story4-1",
     "text": "Hallo, ich bin Mila! Die Sonne scheint. Das Meer wartet!",
     "lines": [
      {
       "who": "mia",
       "audio": "sk4-1a",
       "text": "Juhu, wir fahren los!"
      },
      {
       "who": "max",
       "audio": "sk4-1b",
       "text": "Ich bin fertig!"
      }
     ]
    },
    {
     "img": "img/story4-2.webp",
     "audio": "story4-2",
     "text": "Die Mama ist fertig. Die Mama ruft: Kommt schnell!",
     "lines": [
      {
       "who": "mia",
       "audio": "sk4-2a",
       "text": "Wir kommen schon!"
      },
