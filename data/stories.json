   "title": "Wo ist der Ball?",
   "pages": [
    {
     "img": "img/story2-1.webp",
     "audio": "story2-1",
     "text": "Die Sonne lacht. Der Hund wacht auf. Der Ball ist auch da."
    },
    {
     "img": "img/story2-2.webp",
     "audio": "story2-2",
     "text": "Oh nein! Wo ist der Ball? Der Ball ist weg!"
    },
    {
     "img": "img/story2-3.webp",
     "audio": "story2-3",
     "text": "Da kommt die Katze. „Ich helfe dir!“, sagt die Katze.",
     "q": {
      "text": "Wer hilft?",
      "audio": "sq-hilft",
      "answer": "katze",
      "choices": [
       "katze",
       "hund",
       "auto"
      ]
     }
    },
    {
     "img": "img/story2-4.webp",
     "audio": "story2-4",
     "text": "Das Auto ist lila. Die Katze und der Hund fahren los. Brumm, brumm!",
     "q": {
      "text": "Was fährt?",
      "audio": "sq-faehrt",
      "answer": "auto",
      "choices": [
       "auto",
       "haus",
       "blume"
      ]
     }
    },
    {
     "img": "img/story2-5.webp",
     "audio": "story2-5",
     "text": "Das Haus ist leer. Der Ball ist nicht hier."
    },
    {
     "img": "img/story2-6.webp",
     "audio": "story2-6",
     "text": "Die Blume winkt. „Da drüben!“, sagt die Blume."
    },
    {
     "img": "img/story2-7.webp",
     "audio": "story2-7",
     "text": "Da ist der Ball! Der Ball schwimmt.",
     "q": {
      "text": "Wo ist der Ball? Zeig mal!",
      "audio": "sq-ball",
      "answer": "ball",
      "choices": [
       "ball",
       "banane",
       "ei"
      ]
     }
    },
    {
     "img": "img/story2-8.webp",
     "audio": "story2-8",
     "text": "Der Hund springt. Platsch! Die Katze lacht."
    },
    {
     "img": "img/story2-9.webp",
     "audio": "story2-9",
     "text": "Der Mond kommt. Der Hund und die Katze schlafen. Gute Nacht!",
     "q": {
      "text": "Wer schläft?",
      "audio": "sq-schlaeft",
