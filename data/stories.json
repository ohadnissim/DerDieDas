{
 "stories": [
  {
   "id": "story3-long",
   "title": "Die Murmel ist weg!",
   "pages": [
    {
     "img": "img/story3-1.webp",
     "audio": "story3-1",
     "text": "Guten Morgen! Mila ist da. Mia, Mil und Max sind auch da.",
     "lines": [
      {
       "who": "mil",
       "audio": "sk3-1",
       "text": "Guten Morgen, Mila!"
      }
     ]
    },
    {
     "img": "img/story3-2.webp",
     "audio": "story3-2",
     "text": "Oh nein! Die Murmel ist weg! Mia weint. „Wir suchen!“, sagt Mila.",
     "lines": [
      {
       "who": "mia",
       "audio": "sk3-2",
       "text": "Wo ist die Murmel?"
      },
      {
       "who": "max",
       "audio": "sk3-2a",
       "text": "Ich helfe!"
      },
      {
       "who": "mil",
       "audio": "sk3-2b",
       "text": "Ich auch!"
      }
     ]
    },
    {
     "img": "img/story3-3.webp",
     "audio": "story3-3",
     "text": "Die Ampel ist rot. Stopp! Der Mann winkt. Jetzt ist die Ampel grün. Los!",
     "lines": [
      {
       "who": "max",
       "audio": "sk3-3",
       "text": "Stopp! Die Ampel ist rot!"
      }
     ],
     "ask": {
      "word": "ampel",
      "who": "max"
     }
    },
    {
     "img": "img/story3-4.webp",
     "audio": "story3-4",
     "text": "Da ist die Mauer. Die Maus guckt. „Nicht hier!“, piepst die Maus.",
     "lines": [
      {
       "who": "mil",
       "audio": "sk3-4",
       "text": "Hallo, Maus!"
      }
     ],
     "q": {
      "text": "Wer piepst?",
      "audio": "sq3-piepst",
      "answer": "maus",
      "choices": [
       "maus",
       "wurm",
       "ameise"
      ]
     }
    },
    {
     "img": "img/story3-5.webp",
     "audio": "story3-5",
     "text": "Der Wurm kriecht. Die Ameise krabbelt. Der Eimer ist leer.",
     "lines": [
      {
       "who": "mil",
       "audio": "sk3-5",
       "text": "Oh, ein Wurm!"
      }
     ],
     "ask": {
      "word": "eimer",
      "who": "mil"
     }
    },
    {
     "img": "img/story3-mantel.webp",
     "audio": "story3-mantel",
     "text": "Da liegt der Mantel. Ist die Murmel da?",
     "lines": [
      {
       "who": "mia",
       "audio": "sk3-mantel",
       "text": "Nein, nicht da!"
      }
     ],
     "ask": {
      "word": "mantel",
      "who": "mia"
     }
    },
    {
     "img": "img/story3-6.webp",
     "audio": "story3-6",
     "text": "Der Helm ist rot. Max ist schnell! Aber die Murmel ist nicht da.",
     "lines": [
      {
       "who": "max",
       "audio": "sk3-6",
       "text": "Ich bin schnell!"
      }
     ],
     "ask": {
      "word": "helm",
      "who": "max"
     }
    },
    {
     "img": "img/story3-7.webp",
     "audio": "story3-7",
     "text": "Da kommt die Mama. Der Mantel ist warm. Der Mund lacht. „Schaut mal!“, sagt die Mama.",
     "lines": [
      {
       "who": "mia",
       "audio": "sk3-7",
       "text": "Hallo, Mama!"
      }
     ]
    },
    {
     "img": "img/story3-8.webp",
     "audio": "story3-8",
     "text": "Da ist die Muschel. Und da? Da ist die Murmel! Juhu!",
     "lines": [
      {
       "who": "mia",
       "audio": "sk3-8",
       "text": "Juhu! Da ist die Murmel!"
      }
     ],
