    },
    {
     "img": "img/story4-6.webp",
     "audio": "story4-6",
     "text": "Alle sind durstig. Da ist die Milch. Die Milch ist kalt!",
     "lines": [
      {
       "who": "mia",
       "audio": "sk4-6a",
       "text": "Die Milch ist lecker!"
